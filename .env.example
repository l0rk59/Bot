# Copier ce fichier en « .env » puis remplir les valeurs.
# Le fichier .env contient des secrets : il ne doit jamais être envoyé sur GitHub.

# Jeton donné par @BotFather sur Telegram.
PRICEBOT_TELEGRAM_TOKEN=

# Identifiant du groupe Telegram qui reçoit les alertes.
# Pour le trouver : uv run pricebot telegram-test
PRICEBOT_TELEGRAM_CHAT_ID=

# Minutes entre deux passages sur les sites (minimum 1).
PRICEBOT_CHECK_INTERVAL_MINUTES=15

# Alerte si le prix tombe sous cette fraction du prix habituel (0.5 = -50 %).
PRICEBOT_MAX_RATIO=0.5

# Économie minimale, en euros, pour déclencher une alerte.
PRICEBOT_MIN_SAVING=30

# Optionnel : adresse de « ping » Healthchecks.io, pour être prévenu si le bot s'arrête.
PRICEBOT_HEALTHCHECK_URL=
